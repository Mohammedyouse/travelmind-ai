# ==============================================================================
# TravelMind AI — Production Cloud Environment Template
# Configure these variables in your cloud hosting dashboards (Railway, Vercel, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend (Railway)
# ------------------------------------------------------------------------------
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-64-char-hex-string

# Production CORS: Must include your production Vercel frontend URL
CORS_ORIGINS=https://travelmind-frontend.vercel.app,http://localhost:5173

# Cloud PostgreSQL (Neon Serverless Postgres):
# Format: postgresql://<user>:<password>@<neon-host>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloud Redis (Upstash Serverless Redis):
# Format: rediss://default:<password>@<upstash-host>.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379

# Live AI / LLM Provider (Google Gemini)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# Real Travel Data Providers (Amadeus)
# Register at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Places & Weather
# (OpenStreetMap Nominatim, Open-Meteo & Frankfurter work live with zero keys required)
PLACES_API_KEY=
WEATHER_API_KEY=
FX_API_KEY=

# n8n Automation Engine Gateway
# Set this to the public HTTPS URL of your Railway n8n deployment
N8N_HOST=https://travelmind-n8n-production.up.railway.app
N8N_WEBHOOK_URL=https://travelmind-n8n-production.up.railway.app/webhook/travel-plan-orchestrator
N8N_WEBHOOK_SECRET=generate-a-shared-hmac-secret-for-n8n-and-backend
TRAVELMIND_API_BASE_URL=https://travelmind-api-production.up.railway.app

# ------------------------------------------------------------------------------
# 2. n8n Automation Engine (Railway)
# ------------------------------------------------------------------------------
# N8N_HOST=0.0.0.0
# N8N_PORT=5678
# N8N_PROTOCOL=https
# NODE_ENV=production
# WEBHOOK_URL=https://travelmind-n8n-production.up.railway.app/
# N8N_WEBHOOK_SECRET=generate-a-shared-hmac-secret-for-n8n-and-backend
# TRAVELMIND_API_BASE_URL=https://travelmind-api-production.up.railway.app
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# (Optional: Connect n8n directly to Neon PostgreSQL so workflows persist in DB):
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=<neon-host>.aws.neon.tech
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=neondb
# DB_POSTGRESDB_USER=neondb_owner
# DB_POSTGRESDB_PASSWORD=<neon-password>
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 3. React Frontend (Vercel)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables:
# VITE_API_BASE_URL=https://travelmind-api-production.up.railway.app
