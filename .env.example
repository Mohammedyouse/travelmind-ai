# ==============================================================================
# TravelMind AI — Environment Configuration Template
# Copy to .env and configure keys for your deployment environment.
# ==============================================================================

# Application & Authentication
APP_ENV=development
JWT_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence
# Local SQLite default: sqlite:///./travelmind.db
# PostgreSQL docker/prod: postgresql+psycopg://travelmind:travelmind@localhost:5432/travelmind
DATABASE_URL=sqlite:///./travelmind.db
POSTGRES_DB=travelmind
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=travelmind
POSTGRES_HOST_PORT=5433

# Caching & Queue
REDIS_URL=redis://localhost:6379/0

# AI / LLM Synthesis (Google Gemini)
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=

# Flight & Hotel Intelligence (Amadeus Self-Service)
# Register at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Destination & Places Intelligence
# (OpenStreetMap Nominatim/Overpass works live with zero key required)
# Optional Google Places API Key:
PLACES_API_KEY=

# Live Weather & Foreign Exchange
# (Open-Meteo & open.er-api work live with zero keys required)
WEATHER_API_KEY=
FX_API_KEY=

# Communication & Notifications
WHATSAPP_TOKEN=
EMAIL_API_KEY=

# Stripe Billing & SaaS Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# n8n Automation Engine Integration
N8N_HOST_PORT=5680
N8N_HOST=http://localhost:5680
WEBHOOK_URL=http://localhost:5680/
N8N_WEBHOOK_URL=http://localhost:5680/webhook/travel-plan-orchestrator
N8N_WEBHOOK_SECRET=travelmind-n8n-secret
TRAVELMIND_API_BASE_URL=http://localhost:8000

# Frontend Client
VITE_API_BASE_URL=http://localhost:8000
